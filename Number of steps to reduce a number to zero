import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter an Integer: ");
        int num = scanner.nextInt();

        int count = 0;

        while (num != 0) {
            if (num % 2 == 0) {
                num = num / 2;
                count++;
            } else {
                num -= 1;
                count++;
            }
        }

        System.out.println("The number of steps to reduce the number to zero is: " + count);
    }
}
