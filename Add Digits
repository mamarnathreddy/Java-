import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int num = scanner.nextInt();

        while (num / 10 != 0) {
            int dig1 = num % 10;
            int dig2 = num / 10;
            num = dig1 + dig2;
        }

        System.out.println(num);
    }
}
